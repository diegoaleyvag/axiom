{
  "name": "axiom",
  "version": "0.1.0",
  "private": true,
  "description": "Axiom validates structured AI outputs as software contracts, offline and provider-neutral.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "build": "tsc --build",
    "build:action-bundle": "node scripts/build-action-bundle.mjs",
    "action:bundle:check": "node scripts/verify-action-bundle.mjs",
    "examples:evidence:check": "node scripts/verify-example-evidence.mjs",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
